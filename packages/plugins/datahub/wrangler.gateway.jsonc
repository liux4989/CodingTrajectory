{
  "$schema": "./web/node_modules/wrangler/config-schema.json",
  "name": "coding-trajectory-datahub-preview",
  "main": "web/worker/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "DATAHUB_FACADE",
      "service": "coding-trajectory-datahub-facade-preview"
    }
  ],
  "secrets": {
    "required": [
      "CF_ACCESS_TEAM_DOMAIN",
      "CF_ACCESS_AUD"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
