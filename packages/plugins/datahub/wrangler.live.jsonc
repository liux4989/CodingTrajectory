{
  "$schema": "./web/node_modules/wrangler/config-schema.json",
  "name": "coding-trajectory-datahub-live",
  "main": "web/worker/live.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [{"binding": "CORE", "service": "coding-trajectory-control-plane"}],
  "secrets": {"required": ["CF_ACCESS_TEAM_DOMAIN", "CF_ACCESS_AUD", "CT_WORKSPACE_ID", "CT_CORE_READ_TOKEN"]},
  "version_metadata": {"binding": "WORKER_VERSION"},
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "env": {
    "staging": {
      "name": "coding-trajectory-datahub-staging",
      "services": [{"binding": "CORE", "service": "coding-trajectory-control-plane-staging"}],
      "secrets": {"required": ["CF_ACCESS_TEAM_DOMAIN", "CF_ACCESS_AUD", "CT_WORKSPACE_ID", "CT_CORE_READ_TOKEN"]},
      "version_metadata": {"binding": "WORKER_VERSION"}
    }
  }
}
