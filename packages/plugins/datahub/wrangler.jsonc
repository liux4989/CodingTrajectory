{
  "$schema": "./web/node_modules/wrangler/config-schema.json",
  "name": "coding-trajectory-datahub-facade-preview",
  "main": "datahub_plugin/hosted/worker.py",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "python_modules": {
    "excludes": [
      "**/*.pyc",
      "**/__pycache__",
      "datahub_plugin/hosted/worker.py"
    ]
  }
}
