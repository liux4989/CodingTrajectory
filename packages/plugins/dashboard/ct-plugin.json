{
  "schemaVersion": 1,
  "name": "dashboard",
  "version": "0.1.0",
  "requiresCt": ">=0.1.0",
  "description": "Project and session management dashboard.",
  "run": ["ct-dashboard"],
  "requiresMethods": {
    "project.list": 1,
    "project.sessions": 1,
    "session.overview": 1,
    "session.stats": 1,
    "session.usage": 1,
    "item.details": 1,
    "event.detail": 1
  },
  "tools": [
    {
      "name": ".",
      "summary": "Show dashboard entry information."
    },
    {
      "name": "--tui",
      "summary": "Quick inspection and cleanup (terminal)."
    },
    {
      "name": "web",
      "summary": "Run the dashboard web program."
    },
    {
      "name": "project",
      "summary": "List managed projects and project actions."
    },
    {
      "name": "session",
      "summary": "List sessions and session actions."
    },
    {
      "name": "project/cleanup",
      "summary": "Clean old project directories."
    },
    {
      "name": "session/cleanup",
      "summary": "Clean empty or low-value session logs."
    },
    {
      "name": "session/context-window",
      "summary": "Inspect session context composition and trajectory events."
    }
  ]
}
