{
  "schemaVersion": 1,
  "name": "dashboard",
  "version": "0.1.0",
  "requiresCt": ">=0.1.0",
  "description": "Project and session management dashboard.",
  "run": ["python3", "./dashboard.py"],
  "commands": [
    {
      "name": ".",
      "summary": "Show dashboard entry information."
    },
    {
