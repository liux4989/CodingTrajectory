{
  "name": "coding-trajectory-api",
  "version": "0.3.0",
  "protocol": {
    "transport": "JSON-RPC 2.0",
    "request": {
      "jsonrpc": "2.0",
      "id": "string | number | null",
      "method": "string",
      "params": "<method-specific params object>"
    },
    "success": {
      "jsonrpc": "2.0",
      "id": "<request id>",
      "result": "<method-specific result object>"
    },
    "error": {
      "jsonrpc": "2.0",
      "id": "<request id> | null",
      "error": {
        "code": "number",
        "message": "string",
        "data": "object | null"
      }
    }
  },
  "description": "Replay-first JSON-RPC contract for canonical trajectory, session, turn, and event data.",
  "design_principles": [
    "Use id-driven reads for all canonical resources.",
    "Make session.timeline the primary replay interface.",
    "Model trajectory as a graph of sessions and operations, not a flat session bag.",
    "Support both cross-session multi-agent orchestration and in-session multi-agent orchestration.",
    "Treat trajectory.sections as an ordered presentation view derived from canonical relations and operation boundaries.",
    "Treat turns as grouped event references, not embedded event containers.",
    "Keep collection query methods out of the initial API until concrete query use cases exist."
  ],
  "base_error_codes": [
    {
      "code": -32600,
      "name": "invalid_request",
      "meaning": "The JSON-RPC envelope is malformed."
    },
    {
      "code": -32601,
      "name": "method_not_found",
      "meaning": "The requested method is not implemented."
    },
    {
      "code": -32602,
      "name": "invalid_params",
      "meaning": "The params payload failed validation."
    },
    {
      "code": -32603,
      "name": "internal_error",
      "meaning": "The server failed while processing the request."
    },
    {
      "code": 40400,
      "name": "session_not_found",
      "meaning": "The requested session_id does not exist."
    },
    {
      "code": 40401,
      "name": "trajectory_not_found",
      "meaning": "The requested trajectory_id does not exist."
    },
    {
      "code": 40402,
      "name": "turn_not_found",
      "meaning": "The requested turn_id does not exist."
    },
    {
      "code": 40403,
      "name": "event_not_found",
      "meaning": "The requested event_id does not exist."
    }
  ],
  "shared_types": {
    "Vendor": {
      "type": "string",
      "enum": [
        "codex_cli",
        "claude_code",
        "gemini_cli",
        "amp"
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "session.started",
        "session.resumed",
        "session.ended",
        "user.prompt.submitted",
        "llm.request.started",
        "llm.request.completed",
        "llm.stream.event",
        "tool.call.requested",
        "tool.call.started",
        "tool.call.succeeded",
        "tool.call.failed",
        "permission.requested",
        "permission.approved",
        "permission.denied",
        "subtask.started",
        "subtask.completed",
        "background_task.started",
        "background_task.completed",
        "context.compaction.started",
        "context.compaction.completed",
        "agent.response.completed",
        "task.completed"
      ]
    },
    "TimelineItem": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "event",
            "turn"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "TrajectorySummary": {
      "type": "object",
      "required": [
        "session_count",
        "turn_count",
        "event_count",
        "vendors"
      ],
      "properties": {
        "root_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "turn_count": {
          "type": "integer",
          "minimum": 0
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "agent_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "vendors": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/Vendor"
          }
        }
      }
    },
    "TrajectorySessionRef": {
      "type": "object",
      "required": [
        "session_id",
        "vendor",
        "started_at"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "vendor": {
          "$ref": "#/shared_types/Vendor"
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "primary",
            "subagent",
            "teammate",
            "handoff_target",
            "resumed",
            null
          ]
        },
        "agent_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "team_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_sidechain": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "collaboration_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "TrajectoryEdge": {
      "type": "object",
      "required": [
        "type",
        "source_session_id",
        "target_session_id",
        "provenance",
        "confidence",
        "evidence_event_ids"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "spawned_subagent",
            "sidechain_of",
            "handoff_to",
            "resumed_from",
            "teammate_of"
          ]
        },
        "source_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "evidence_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "synthetic"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "TrajectoryOperation": {
      "type": "object",
      "required": [
        "operation_id",
        "kind",
        "status",
        "session_ids",
        "start_event_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "subagent",
            "handoff",
            "compact",
            "teammate",
            "resume"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "session_graph",
            "session_span"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "started",
            "completed",
            "open",
            "failed"
          ]
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "turn_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "start_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "end_event_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "observed",
            "derived",
            "synthetic",
            null
          ]
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "TrajectorySection": {
      "type": "object",
      "required": [
        "section_id",
        "kind",
        "title",
        "session_ids",
        "event_ids",
        "turn_ids"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "main",
            "subagent",
            "handoff",
            "compact",
            "teammate",
            "resume"
          ]
        },
        "title": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "session_graph",
            "session_span"
          ]
        },
        "operation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "turn_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "InferenceNote": {
      "type": "object",
      "required": [
        "subject",
        "message",
        "provenance",
        "confidence"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "synthetic"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "EventDetail": {
      "type": "object",
      "required": [
        "event_id",
        "session_id",
        "timestamp",
        "type",
        "vendor_source",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "$ref": "#/shared_types/EventType"
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "synthetic"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "vendor_source": {
          "$ref": "#/shared_types/Vendor"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "TurnDetail": {
      "type": "object",
      "required": [
        "turn_id",
        "session_id",
        "started_at",
        "event_ids"
      ],
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_request": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "SessionDetail": {
      "type": "object",
      "required": [
        "session_id",
        "trajectory_id",
        "vendor",
        "started_at",
        "timeline"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "trajectory_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "vendor": {
          "$ref": "#/shared_types/Vendor"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/TimelineItem"
          }
        },
        "extensions": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "TrajectoryDetail": {
      "type": "object",
      "required": [
        "trajectory_id",
        "session_ids",
        "summary",
        "session_refs",
        "edges",
        "operations",
        "sections",
        "inference_notes"
      ],
      "properties": {
        "trajectory_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "multi_agent_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "cross_session",
            "in_session",
            "hybrid",
            null
          ]
        },
        "summary": {
          "$ref": "#/shared_types/TrajectorySummary"
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "session_refs": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/TrajectorySessionRef"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/TrajectoryEdge"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/TrajectoryOperation"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/TrajectorySection"
          }
        },
        "inference_notes": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/InferenceNote"
          }
        }
      }
    }
  },
  "methods": {
    "trajectory.get": {
      "summary": "Fetch one trajectory by id. Returns replay-first graph metadata, section boundaries, and session references; sessions are still fetched separately by id.",
      "params": {
        "type": "object",
        "required": [
          "trajectory_id"
        ],
        "properties": {
          "trajectory_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/TrajectoryDetail"
      }
    },
    "session.get": {
      "summary": "Fetch one session by id. Returns the mixed replay timeline of event refs and turn refs.",
      "params": {
        "type": "object",
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/SessionDetail"
      }
    },
    "turn.get": {
      "summary": "Fetch one turn by id. Returns ordered event ids for that turn only.",
      "params": {
        "type": "object",
        "required": [
          "turn_id"
        ],
        "properties": {
          "turn_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/TurnDetail"
      }
    },
    "event.get": {
      "summary": "Fetch one event by id. Works for both standalone session events and turn-owned events.",
      "params": {
        "type": "object",
        "required": [
          "event_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/EventDetail"
      }
    }
  }
}
