{
  "name": "coding-trajectory-api",
  "version": "0.3.0",
  "protocol": {
    "transport": "JSON-RPC 2.0",
    "request": {
      "jsonrpc": "2.0",
      "id": "string | number | null",
      "method": "string",
      "params": "<method-specific params object>"
    },
    "success": {
      "jsonrpc": "2.0",
      "id": "<request id>",
      "result": "<method-specific result object>"
    },
    "error": {
      "jsonrpc": "2.0",
      "id": "<request id> | null",
      "error": {
        "code": "number",
        "message": "string",
        "data": "object | null"
      }
    }
  },
  "description": "JSON-RPC contract for canonical session, turn, step, and event resources plus structural trajectory aggregates.",
  "design_principles": [
    "Use id-driven reads for all canonical resources.",
    "Treat event, step, turn, and session as canonical normalized resources.",
    "Make session, turn, step, and event refs the primary canonical replay interface.",
    "Treat trajectory as a structural aggregate over canonical sessions, not a flat session bag.",
    "Support both cross-session multi-agent orchestration and in-session multi-agent orchestration.",
    "Keep presentation-oriented interpretations out of canonical resources.",
    "Treat trajectory.sections as an ordered presentation view derived from canonical relations and operation boundaries.",
    "Treat turns as grouped event references, not embedded event containers.",
    "Keep collection query methods out of the initial API until concrete query use cases exist."
  ],
  "base_error_codes": [
    {
      "code": -32600,
      "name": "invalid_request",
      "meaning": "The JSON-RPC envelope is malformed."
    },
    {
      "code": -32601,
      "name": "method_not_found",
      "meaning": "The requested method is not implemented."
    },
    {
      "code": -32602,
      "name": "invalid_params",
      "meaning": "The params payload failed validation."
    },
    {
      "code": -32603,
      "name": "internal_error",
      "meaning": "The server failed while processing the request."
    },
    {
      "code": 40400,
      "name": "session_not_found",
      "meaning": "The requested session_id does not exist."
    },
    {
      "code": 40401,
      "name": "trajectory_not_found",
      "meaning": "The requested trajectory_id does not exist."
    },
    {
      "code": 40402,
      "name": "turn_not_found",
      "meaning": "The requested turn_id does not exist."
    },
    {
      "code": 40403,
      "name": "event_not_found",
      "meaning": "The requested event_id does not exist."
    }
  ],
  "shared_types": {
    "Vendor": {
      "type": "string",
      "enum": [
        "codex_cli",
        "claude_code",
        "gemini_cli",
        "amp"
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "session.started",
        "session.resumed",
        "session.ended",
        "user.prompt.submitted",
        "llm.request.started",
        "llm.request.completed",
        "llm.stream.event",
        "tool.call.requested",
        "tool.call.started",
        "tool.call.succeeded",
        "tool.call.failed",
        "permission.requested",
        "permission.approved",
        "permission.denied",
        "background_task.started",
        "background_task.completed",
        "context.compaction.started",
        "context.compaction.completed",
        "agent.response.completed",
        "task.completed"
      ]
    },
    "EventCategory": {
      "type": "string",
      "description": "High-level logical grouping set by the consumer layer. Links related events (e.g. all events of one tool call) without payload inspection.",
      "enum": [
        "session",
        "user_interaction",
        "llm_inference",
        "tool_call",
        "background_task",
        "permission",
        "context_compaction"
      ]
    },
    "ToolCallKind": {
      "type": "string",
      "description": "Agent/tool-specific classification within a tool call event. Set by the consumer layer.",
      "enum": [
        "regular",
        "subagent",
        "oracle",
        "librarian",
        "github"
      ]
    },
    "ToolCallDetail": {
      "type": "object",
      "description": "Typed detail for TOOL_CALL_* events. Populated by the consumer layer.",
      "properties": {
        "tool_call_id": { "type": ["string", "null"] },
        "tool_name":    { "type": ["string", "null"] },
        "kind":         { "$ref": "#/shared_types/ToolCallKind" },
        "input":        { "type": ["object", "null"] },
        "result":       {},
        "status":       { "type": ["string", "null"], "enum": ["done", "failed", "in_progress", null] }
      }
    },
    "LLMDetail": {
      "type": "object",
      "description": "Typed LLM inference metadata for LLM_REQUEST_* and LLM_STREAM_EVENT events. Populated by the consumer layer.",
      "properties": {
        "model":            { "type": ["string", "null"] },
        "input_tokens":     { "type": ["integer", "null"] },
        "output_tokens":    { "type": ["integer", "null"] },
        "total_tokens":     { "type": ["integer", "null"] },
        "inference_ms":     { "type": ["number", "null"] },
        "reasoning_effort": { "type": ["string", "null"] },
        "stop_reason":      { "type": ["string", "null"] }
      }
    },
    "TextDetail": {
      "type": "object",
      "description": "Typed text content for USER_PROMPT_SUBMITTED and AGENT_RESPONSE_COMPLETED events. Populated by the consumer layer.",
      "required": ["text"],
      "properties": {
        "text":           { "type": "string" },
        "active_editor":  { "type": ["string", "null"] },
        "visible_files":  { "type": ["array", "null"], "items": { "type": "string" } },
        "cursor_location": {},
        "interrupted":    { "type": ["boolean", "null"] }
      }
    },
    "TimelineItem": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "event",
            "turn"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "TrajectorySummary": {
      "type": "object",
      "required": [
        "session_count",
        "turn_count",
        "vendors"
      ],
      "properties": {
        "root_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "turn_count": {
          "type": "integer",
          "minimum": 0
        },
        "agent_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "vendors": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/Vendor"
          }
        }
      }
    },
    "TrajectorySessionRef": {
      "type": "object",
      "required": [
        "session_id",
        "vendor",
        "started_at"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "vendor": {
          "$ref": "#/shared_types/Vendor"
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "primary",
            "subagent",
            "teammate",
            "handoff_target",
            "resumed",
            null
          ]
        },
        "agent_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "team_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_sidechain": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "collaboration_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "TrajectoryEdge": {
      "type": "object",
      "required": [
        "type",
        "source_session_id",
        "target_session_id",
        "provenance",
        "confidence",
        "evidence_event_ids"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "spawned_subagent",
            "sidechain_of",
            "handoff_to",
            "resumed_from",
            "teammate_of"
          ]
        },
        "source_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "evidence_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "synthetic"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "TrajectoryOperation": {
      "type": "object",
      "required": [
        "operation_id",
        "kind",
        "status",
        "session_ids",
        "start_event_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "subagent",
            "handoff",
            "compact",
            "teammate",
            "resume"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "session_graph",
            "session_span"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "started",
            "completed",
            "open",
            "failed"
          ]
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "turn_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "start_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "end_event_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "observed",
            "derived",
            "synthetic",
            null
          ]
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "TrajectorySection": {
      "type": "object",
      "required": [
        "section_id",
        "kind",
        "title",
        "session_ids",
        "event_ids",
        "turn_ids"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "main",
            "subagent",
            "handoff",
            "compact",
            "teammate",
            "resume"
          ]
        },
        "title": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "session_graph",
            "session_span"
          ]
        },
        "operation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "turn_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "InferenceNote": {
      "type": "object",
      "required": [
        "subject",
        "message",
        "provenance",
        "confidence"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "synthetic"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "EventDetail": {
      "type": "object",
      "required": [
        "event_id",
        "session_id",
        "timestamp",
        "type",
        "vendor_source",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "$ref": "#/shared_types/EventType"
        },
        "actor": {
          "type": ["string", "null"]
        },
        "provenance": {
          "type": "string",
          "enum": ["observed", "derived", "synthetic"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "vendor_source": {
          "$ref": "#/shared_types/Vendor"
        },
        "payload": {
          "type": "object",
          "description": "Raw vendor payload — always present; full fidelity log data."
        },
        "category": {
          "description": "Consumer-layer: logical operation this event belongs to.",
          "oneOf": [
            { "$ref": "#/shared_types/EventCategory" },
            { "type": "null" }
          ]
        },
        "event_group_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "Consumer-layer: shared ID across all events in one logical operation (e.g. a tool call lifecycle)."
        },
        "parent_event_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "Consumer-layer: direct parent in the tool-call tree. Null for root events."
        },
        "tool_call": {
          "description": "Consumer-layer: typed tool call detail. Populated for TOOL_CALL_* and BACKGROUND_TASK_* events.",
          "oneOf": [
            { "$ref": "#/shared_types/ToolCallDetail" },
            { "type": "null" }
          ]
        },
        "llm": {
          "description": "Consumer-layer: typed LLM inference detail. Populated for LLM_REQUEST_* and LLM_STREAM_EVENT events.",
          "oneOf": [
            { "$ref": "#/shared_types/LLMDetail" },
            { "type": "null" }
          ]
        },
        "text": {
          "description": "Consumer-layer: typed text content. Populated for USER_PROMPT_SUBMITTED and AGENT_RESPONSE_COMPLETED events.",
          "oneOf": [
            { "$ref": "#/shared_types/TextDetail" },
            { "type": "null" }
          ]
        }
      }
    },
    "TurnDetail": {
      "type": "object",
      "required": [
        "turn_id",
        "session_id",
        "started_at",
        "event_ids"
      ],
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_request_event_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "SessionDetail": {
      "type": "object",
      "required": [
        "session_id",
        "trajectory_id",
        "vendor",
        "started_at",
        "turn_ids",
        "event_ids"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "trajectory_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "vendor": {
          "$ref": "#/shared_types/Vendor"
        },
        "agent_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "turn_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "extensions": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "TrajectoryDetail": {
      "type": "object",
      "required": [
        "trajectory_id",
        "session_ids",
        "summary",
        "edges"
      ],
      "properties": {
        "trajectory_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "$ref": "#/shared_types/TrajectorySummary"
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/TrajectoryEdge"
          }
        }
      }
    }
  },
  "methods": {
    "trajectory.get": {
      "summary": "Fetch one trajectory by id. Returns canonical trajectory metadata, edges, and member session ids.",
      "params": {
        "type": "object",
        "required": [
          "trajectory_id"
        ],
        "properties": {
          "trajectory_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/TrajectoryDetail"
      }
    },
    "session.get": {
      "summary": "Fetch one session by id. Returns canonical session metadata plus turn and event refs.",
      "params": {
        "type": "object",
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/SessionDetail"
      }
    },
    "turn.get": {
      "summary": "Fetch one turn by id. Returns ordered event ids for that turn only.",
      "params": {
        "type": "object",
        "required": [
          "turn_id"
        ],
        "properties": {
          "turn_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/TurnDetail"
      }
    },
    "event.get": {
      "summary": "Fetch one event by id. Works for both standalone session events and turn-owned events.",
      "params": {
        "type": "object",
        "required": [
          "event_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/EventDetail"
      }
    }
  }
}
