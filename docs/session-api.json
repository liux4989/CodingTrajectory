{
  "name": "coding-trajectory-api",
  "version": "0.2.0",
  "protocol": {
    "transport": "JSON-RPC 2.0",
    "request": {
      "jsonrpc": "2.0",
      "id": "string | number | null",
      "method": "string",
      "params": "<method-specific params object>"
    },
    "success": {
      "jsonrpc": "2.0",
      "id": "<request id>",
      "result": "<method-specific result object>"
    },
    "error": {
      "jsonrpc": "2.0",
      "id": "<request id> | null",
      "error": {
        "code": "number",
        "message": "string",
        "data": "object | null"
      }
    }
  },
  "description": "Replay-first JSON-RPC contract for canonical trajectory, session, turn, and event data.",
  "design_principles": [
    "Use id-driven reads for all canonical resources.",
    "Make session.timeline the primary replay interface.",
    "Treat turns as grouped event references, not embedded event containers.",
    "Keep collection query methods out of the initial API until concrete query use cases exist."
  ],
  "base_error_codes": [
    {
      "code": -32600,
      "name": "invalid_request",
      "meaning": "The JSON-RPC envelope is malformed."
    },
    {
      "code": -32601,
      "name": "method_not_found",
      "meaning": "The requested method is not implemented."
    },
    {
      "code": -32602,
      "name": "invalid_params",
      "meaning": "The params payload failed validation."
    },
    {
      "code": -32603,
      "name": "internal_error",
      "meaning": "The server failed while processing the request."
    },
    {
      "code": 40400,
      "name": "session_not_found",
      "meaning": "The requested session_id does not exist."
    },
    {
      "code": 40401,
      "name": "trajectory_not_found",
      "meaning": "The requested trajectory_id does not exist."
    },
    {
      "code": 40402,
      "name": "turn_not_found",
      "meaning": "The requested turn_id does not exist."
    },
    {
      "code": 40403,
      "name": "event_not_found",
      "meaning": "The requested event_id does not exist."
    }
  ],
  "shared_types": {
    "Vendor": {
      "type": "string",
      "enum": [
        "codex_cli",
        "claude_code",
        "gemini_cli",
        "amp"
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "session.started",
        "session.resumed",
        "session.ended",
        "user.prompt.submitted",
        "llm.request.started",
        "llm.request.completed",
        "llm.stream.event",
        "tool.call.requested",
        "tool.call.started",
        "tool.call.succeeded",
        "tool.call.failed",
        "permission.requested",
        "permission.approved",
        "permission.denied",
        "subtask.started",
        "subtask.completed",
        "background_task.started",
        "background_task.completed",
        "context.compaction.started",
        "context.compaction.completed",
        "agent.response.completed",
        "task.completed"
      ]
    },
    "TimelineItem": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "event",
            "turn"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "EventDetail": {
      "type": "object",
      "required": [
        "event_id",
        "session_id",
        "timestamp",
        "type",
        "vendor_source",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "$ref": "#/shared_types/EventType"
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "synthetic"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "vendor_source": {
          "$ref": "#/shared_types/Vendor"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "TurnDetail": {
      "type": "object",
      "required": [
        "turn_id",
        "session_id",
        "started_at",
        "event_ids"
      ],
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_request": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "SessionDetail": {
      "type": "object",
      "required": [
        "session_id",
        "trajectory_id",
        "vendor",
        "started_at",
        "timeline"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "trajectory_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "vendor": {
          "$ref": "#/shared_types/Vendor"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/TimelineItem"
          }
        },
        "extensions": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "TrajectoryDetail": {
      "type": "object",
      "required": [
        "trajectory_id",
        "session_ids"
      ],
      "properties": {
        "trajectory_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "methods": {
    "trajectory.get": {
      "summary": "Fetch one trajectory by id. Returns session ids only; sessions are fetched separately by id.",
      "params": {
        "type": "object",
        "required": [
          "trajectory_id"
        ],
        "properties": {
          "trajectory_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/TrajectoryDetail"
      }
    },
    "session.get": {
      "summary": "Fetch one session by id. Returns the mixed replay timeline of event refs and turn refs.",
      "params": {
        "type": "object",
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/SessionDetail"
      }
    },
    "turn.get": {
      "summary": "Fetch one turn by id. Returns ordered event ids for that turn only.",
      "params": {
        "type": "object",
        "required": [
          "turn_id"
        ],
        "properties": {
          "turn_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/TurnDetail"
      }
    },
    "event.get": {
      "summary": "Fetch one event by id. Works for both standalone session events and turn-owned events.",
      "params": {
        "type": "object",
        "required": [
          "event_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/EventDetail"
      }
    }
  }
}
