{
  "name": "coding-trajectory-api",
  "version": "0.2.0",
  "protocol": "JSON-RPC 2.0",
  "description": "Replay-first JSON-RPC contract for canonical trajectory, session, turn, and event data.",
  "design_principles": [
    "Use id-driven reads for all canonical resources.",
    "Make session.timeline the primary replay interface.",
    "Treat turns as grouped event references, not embedded event containers.",
    "Keep collection query methods out of the initial API until concrete query use cases exist."
  ],
  "base_request_shape": {
    "jsonrpc": "2.0",
    "id": "string | number | null",
    "method": "string",
    "params": {}
  },
  "base_error_codes": [
    {
      "code": -32600,
      "name": "invalid_request",
      "meaning": "The JSON-RPC envelope is malformed."
    },
    {
      "code": -32601,
      "name": "method_not_found",
      "meaning": "The requested method is not implemented."
    },
    {
      "code": -32602,
      "name": "invalid_params",
      "meaning": "The params payload failed validation."
    },
    {
      "code": -32603,
      "name": "internal_error",
      "meaning": "The server failed while processing the request."
    },
    {
      "code": 40400,
      "name": "session_not_found",
      "meaning": "The requested session_id does not exist."
    },
    {
      "code": 40401,
      "name": "trajectory_not_found",
      "meaning": "The requested trajectory_id does not exist."
    },
    {
      "code": 40402,
      "name": "turn_not_found",
      "meaning": "The requested turn_id does not exist."
    },
    {
      "code": 40403,
      "name": "event_not_found",
      "meaning": "The requested event_id does not exist."
    }
  ],
  "shared_types": {
    "Vendor": {
      "type": "string",
      "enum": [
        "codex_cli",
        "claude_code",
        "gemini_cli",
        "amp"
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "session.started",
        "session.resumed",
        "session.ended",
        "user.prompt.submitted",
        "llm.request.started",
        "llm.request.completed",
        "llm.stream.event",
        "tool.call.requested",
        "tool.call.started",
        "tool.call.succeeded",
        "tool.call.failed",
        "permission.requested",
        "permission.approved",
        "permission.denied",
        "subtask.started",
        "subtask.completed",
        "background_task.started",
        "background_task.completed",
        "context.compaction.started",
        "context.compaction.completed",
        "agent.response.completed",
        "task.completed"
      ]
    },
    "TimelineItem": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "event",
            "turn"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "EventDetail": {
      "type": "object",
      "required": [
        "event_id",
        "session_id",
        "timestamp",
        "type",
        "vendor_source",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "$ref": "#/shared_types/EventType"
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "synthetic"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "vendor_source": {
          "$ref": "#/shared_types/Vendor"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "TurnDetail": {
      "type": "object",
      "required": [
        "turn_id",
        "session_id",
        "started_at",
        "event_ids"
      ],
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_request": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "SessionDetail": {
      "type": "object",
      "required": [
        "session_id",
        "trajectory_id",
        "vendor",
        "started_at",
        "timeline"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "trajectory_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "vendor": {
          "$ref": "#/shared_types/Vendor"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/shared_types/TimelineItem"
          }
        },
        "extensions": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "TrajectoryDetail": {
      "type": "object",
      "required": [
        "trajectory_id",
        "session_ids"
      ],
      "properties": {
        "trajectory_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "methods": {
    "trajectory.get": {
      "summary": "Fetch one trajectory by id. Returns session ids only; sessions are fetched separately by id.",
      "params": {
        "type": "object",
        "required": [
          "trajectory_id"
        ],
        "properties": {
          "trajectory_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/TrajectoryDetail"
      },
      "example": {
        "request": {
          "jsonrpc": "2.0",
          "id": "req-t1",
          "method": "trajectory.get",
          "params": {
            "trajectory_id": "a8a7f6e5-b3bb-46e5-b2eb-7f7a8ad9545a"
          }
        }
      }
    },
    "session.get": {
      "summary": "Fetch one session by id. Returns the mixed replay timeline of event refs and turn refs.",
      "params": {
        "type": "object",
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/SessionDetail"
      },
      "example": {
        "request": {
          "jsonrpc": "2.0",
          "id": "req-s1",
          "method": "session.get",
          "params": {
            "session_id": "3bb69f88-4164-499d-b366-d6a15cb6f88f"
          }
        },
        "result": {
          "session_id": "3bb69f88-4164-499d-b366-d6a15cb6f88f",
          "trajectory_id": "a8a7f6e5-b3bb-46e5-b2eb-7f7a8ad9545a",
          "vendor": "codex_cli",
          "started_at": "2026-03-13T10:00:00Z",
          "ended_at": "2026-03-13T10:05:00Z",
          "timeline": [
            {
              "kind": "event",
              "id": "11111111-1111-1111-1111-111111111111"
            },
            {
              "kind": "turn",
              "id": "22222222-2222-2222-2222-222222222222"
            },
            {
              "kind": "event",
              "id": "33333333-3333-3333-3333-333333333333"
            }
          ],
          "extensions": null
        }
      }
    },
    "turn.get": {
      "summary": "Fetch one turn by id. Returns ordered event ids for that turn only.",
      "params": {
        "type": "object",
        "required": [
          "turn_id"
        ],
        "properties": {
          "turn_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/TurnDetail"
      },
      "example": {
        "request": {
          "jsonrpc": "2.0",
          "id": "req-turn1",
          "method": "turn.get",
          "params": {
            "turn_id": "22222222-2222-2222-2222-222222222222"
          }
        },
        "result": {
          "turn_id": "22222222-2222-2222-2222-222222222222",
          "session_id": "3bb69f88-4164-499d-b366-d6a15cb6f88f",
          "user_request": "Fix the failing test",
          "started_at": "2026-03-13T10:00:10Z",
          "ended_at": "2026-03-13T10:01:00Z",
          "event_ids": [
            "44444444-4444-4444-4444-444444444444",
            "55555555-5555-5555-5555-555555555555"
          ]
        }
      }
    },
    "event.get": {
      "summary": "Fetch one event by id. Works for both standalone session events and turn-owned events.",
      "params": {
        "type": "object",
        "required": [
          "event_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/shared_types/EventDetail"
      },
      "example": {
        "request": {
          "jsonrpc": "2.0",
          "id": "req-event1",
          "method": "event.get",
          "params": {
            "event_id": "44444444-4444-4444-4444-444444444444"
          }
        },
        "result": {
          "event_id": "44444444-4444-4444-4444-444444444444",
          "session_id": "3bb69f88-4164-499d-b366-d6a15cb6f88f",
          "turn_id": "22222222-2222-2222-2222-222222222222",
          "timestamp": "2026-03-13T10:00:15Z",
          "type": "tool.call.requested",
          "actor": "assistant",
          "provenance": "observed",
          "confidence": "high",
          "vendor_source": "codex_cli",
          "payload": {
            "tool_name": "exec_command",
            "tool_call_id": "call-1"
          }
        }
      }
    }
  }
}
